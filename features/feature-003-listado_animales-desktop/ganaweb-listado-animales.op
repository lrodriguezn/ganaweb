    {"id":"page-error","name":"07 Estado error 500 o timeout","children":[{"id":"error","type":"frame","name":"Error servidor o timeout de listado","x":0,"y":0,"width":1440,"height":900,"fill":[{"type":"solid","color":"$surface.canvas"}],"children":[{"id":"err-title","type":"text","x":510,"y":350,"content":"No pudimos cargar los animales","fontSize":26,"fontWeight":700},{"id":"err-copy","type":"text","x":540,"y":405,"content":"Intenta nuevamente en unos momentos.","fontSize":14},{"id":"err-action","type":"text","x":655,"y":450,"content":"Reintentar","fontSize":14,"fontWeight":700,"fill":[{"type":"solid","color":"$action.primary"}]},{"id":"400-note","type":"text","x":390,"y":520,"content":"Nota: HTTP 400 no usa esta pantalla; conserva la última tabla, sanea la URL y muestra toast.","fontSize":12,"fill":[{"type":"solid","color":"$text.secondary"}]}]}]},
    {"id":"page-selector","name":"08 Selector 36 columnas","children":[{"id":"selector","type":"frame","name":"Selector - 29 activas y 7 opcionales","x":0,"y":0,"width":720,"height":900,"fill":[{"type":"solid","color":"$surface.panel"}],"children":[{"id":"sel-title","type":"text","x":28,"y":24,"content":"Columnas · 29 de 36 activas","fontSize":22,"fontWeight":700},{"id":"sel-base","type":"text","x":28,"y":76,"width":650,"content":"ACTIVAS\n☑ Código (fija)\n☑ Nombre (fija)\n☑ Sexo\n☑ Raza\n☑ Fecha nacimiento\n☑ Edad\n☑ Color\n☑ Origen\n☑ Madre (Cód.)\n☑ Madre (Nom.)\n☑ Padre (Cód.)\n☑ Padre (Nom.)\n☑ Propietario\n☑ Hierro\n☑ No. Pezones\n☑ Calidad\n☑ Arete\n☑ Fecha compra\n☑ Precio\n☑ Peso compra\n☑ Tatuado\n☑ Herrado\n☑ Descornado\n☑ RFID\n☑ Potrero\n☑ Sector\n☑ Lote\n☑ Grupo\n☑ Comentarios","fontSize":13,"lineHeight":22},{"id":"sel-optional","type":"text","x":360,"y":76,"width":320,"content":"OPCIONALES\n☐ Salud\n☐ Categoría reprod.\n☐ Estado\n☐ Peso último\n☐ QR\n☐ Es de monta\n☐ Tipo explotación","fontSize":13,"lineHeight":24},{"id":"sel-reset","type":"text","x":360,"y":315,"content":"Restablecer 29 base","fontSize":13,"fontWeight":700,"fill":[{"type":"solid","color":"$action.primary"}]},{"id":"sel-note","type":"text","x":360,"y":355,"width":300,"content":"Persistencia por usuario + finca mediante endpoint. Sin localStorage.","fontSize":12,"fill":[{"type":"solid","color":"$text.secondary"}]}]}]},
    {"id":"page-export","name":"09 Diálogo exportación","children":[{"id":"export-dialog","type":"frame","name":"Exportar animales - referencia estática del estado HTTP 500, no evidencia de runtime","x":420,"y":120,"width":600,"height":610,"fill":[{"type":"solid","color":"$surface.panel"}],"stroke":{"thickness":1,"fill":[{"type":"solid","color":"$border.default"}]},"cornerRadius":12,"children":[{"id":"exp-title","type":"text","x":28,"y":28,"content":"Exportar animales","fontSize":24,"fontWeight":700},{"id":"exp-scope","type":"text","x":28,"y":88,"content":"Columnas\n◉ Vista actual · 29 columnas (cols normalizado)\n○ Todas · 36 columnas","fontSize":14,"lineHeight":28},{"id":"exp-format","type":"text","x":28,"y":210,"content":"Formato\n◉ Excel (.xlsx)\n○ CSV\n○ PDF apaisado","fontSize":14,"lineHeight":28},{"id":"exp-count","type":"text","x":28,"y":350,"content":"Se exportarán 128 animales filtrados, no solo la página de 25.","fontSize":13,"fontWeight":600},{"id":"exp-errors","type":"text","x":28,"y":395,"width":540,"content":"413: afina los filtros · timeout 30 s: mensaje específico · 403: acceso denegado · 400: sanear URL y conservar última tabla.","fontSize":12,"fill":[{"type":"solid","color":"$text.secondary"}]},{"id":"exp-500-message","type":"text","x":28,"y":430,"width":540,"content":"HTTP 500: No pudimos generar la exportación. Conservamos filtros, columnas y formato.","fontSize":12,"fontWeight":600,"fill":[{"type":"solid","color":"$status.danger"}]},{"id":"exp-500-retry","type":"text","x":28,"y":462,"content":"Reintentar","fontSize":13,"fontWeight":700,"fill":[{"type":"solid","color":"$action.primary"}]},{"id":"exp-static-note","type":"text","x":28,"y":492,"width":350,"content":"Referencia estática de la conducta esperada; debe verificarse en código y tests.","fontSize":11,"fill":[{"type":"solid","color":"$text.secondary"}]},{"id":"exp-button","type":"frame","x":402,"y":530,"width":166,"height":42,"fill":[{"type":"solid","color":"$action.primary"}],"cornerRadius":8,"children":[{"id":"exp-button-t","type":"text","x":44,"y":13,"content":"Exportar","fontSize":13,"fontWeight":700,"fill":[{"type":"solid","color":"$action.onPrimary"}]}]}]}]},
    {"id":"page-pdf","name":"10 Advertencia PDF","children":[{"id":"pdf","type":"frame","name":"Advertencia PDF 36 columnas","x":420,"y":220,"width":600,"height":390,"fill":[{"type":"solid","color":"$surface.panel"}],"stroke":{"thickness":1,"fill":[{"type":"solid","color":"$border.default"}]},"cornerRadius":12,"children":[{"id":"pdf-title","type":"text","x":28,"y":28,"content":"El PDF puede ser difícil de leer","fontSize":22,"fontWeight":700},{"id":"pdf-copy","type":"text","x":28,"y":86,"width":530,"content":"Las 36 columnas no caben con comodidad en una página apaisada. Para conservar legibilidad recomendamos exportar en Excel.","fontSize":14},{"id":"pdf-excel","type":"text","x":28,"y":250,"content":"Cambiar a Excel","fontSize":14,"fontWeight":700,"fill":[{"type":"solid","color":"$action.primary"}]},{"id":"pdf-continue","type":"text","x":390,"y":250,"content":"Continuar con PDF","fontSize":14,"fontWeight":700}]}]}
  ]
}
